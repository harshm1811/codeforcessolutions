#include <bits/stdc++.h>
using namespace std;
 
#define ll long long
#define nl '
'
 
void solve() {
    int n,k;
    cin>>n>>k;
    vector<int> v(n);
    bool exist=false;
    for(int i=0;i<n;i++) {
        cin>>v[i];
        if(v[i]==k) exist=true;
    }
    if(exist) cout<<"yes"<<nl;
    else cout<<"no"<<nl;
    
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}